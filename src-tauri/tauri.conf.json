{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Voxlery",
  "version": "1.0.0",
  "identifier": "com.voxlery.app",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://127.0.0.1:8642"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Voxlery AI — Local Semantic Photo Search",
        "width": 1380,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
